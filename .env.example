OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=my_qwen:latest
OLLAMA_VISION_MODEL=
ZIPKA_DATA_DIR=data
ZIPKA_REFLECT_EVERY=8
ZIPKA_NET_ALLOWLIST=ru.wikipedia.org,en.wikipedia.org,docs.python.org,raw.githubusercontent.com,github.com
ZIPKA_NET_MAX_BYTES=500000
ZIPKA_WHISPER_MODEL=base
# Лимит размера книги/архива в байтах (пусто = авто от доступной RAM, ~12%, 32–512 МБ)
