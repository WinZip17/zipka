OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=my_qwen:latest
OLLAMA_VISION_MODEL=
# auto = если в data/models есть *.gguf → локальный GGUF, иначе Ollama
ZIPKA_LLM_BACKEND=auto
# чатовый профиль: pathfinder | qwen25 (см. data/models/README.md)
ZIPKA_CHAT_MODEL=pathfinder
# имя файла в data/models (пусто = по профилю ZIPKA_CHAT_MODEL)
ZIPKA_GGUF_MODEL=
ZIPKA_GGUF_CTX=8192
ZIPKA_GGUF_MAX_TOKENS=1024
ZIPKA_GGUF_GPU_LAYERS=0
ZIPKA_GGUF_THREADS=0
ZIPKA_DATA_DIR=data
ZIPKA_REFLECT_EVERY=8
ZIPKA_NET_ALLOWLIST=ru.wikipedia.org,en.wikipedia.org,docs.python.org,raw.githubusercontent.com,github.com,habr.com,cdn.habr.com,medium.com,dev.to,stackoverflow.com,learn.microsoft.com
ZIPKA_NET_MAX_BYTES=500000
ZIPKA_WHISPER_MODEL=base
# Лимит размера книги/архива в байтах (пусто = авто от доступной RAM, ~12%, 32–512 МБ)
# ZIPKA_MAX_BOOK_BYTES=83886080
